{
  "installCommand": "npm install --legacy-peer-deps",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/charcoal",
      "destination": "/activated-carbon",
      "permanent": true
    },
    {
      "source": "/charcoal/",
      "destination": "/activated-carbon",
      "permanent": true
    },
    {
      "source": "/activated-carbon/",
      "destination": "/activated-carbon",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/bamboo-products",
      "destination": "/bamboo-products.html"
    },
    {
      "source": "/activated-carbon",
      "destination": "/activated-carbon.html"
    },
    {
      "source": "/printing-services",
      "destination": "/printing-services.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}
