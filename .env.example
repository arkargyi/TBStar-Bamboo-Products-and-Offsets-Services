# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server-Side Inquiry Delivery Configuration (Optional — keep private, never prefix with VITE_)
# Option 1: SMTP Email Delivery via Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TB Star Website <info@tbstarcompany.com>"
INQUIRY_TO_EMAIL="info@tbstarcompany.com"

# Option 2: Resend HTTP API Delivery (Alternative to SMTP)
RESEND_API_KEY=""

# Option 3: Custom Webhook Delivery (e.g., Slack / Google Chat / CRM webhook)
INQUIRY_WEBHOOK_URL=""

