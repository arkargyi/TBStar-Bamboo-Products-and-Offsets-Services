# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Contact form delivery through Resend on Vercel.
# Verify mail.tbstarcompany.com in Resend before using this sender address.
# Put the real API key in Vercel Environment Variables; never commit it here.
RESEND_API_KEY=""
INQUIRY_TO_EMAIL="info@tbstarcompany.com"
INQUIRY_FROM_EMAIL="TB Star Website <website@mail.tbstarcompany.com>"

# Optional custom webhook delivery (e.g., Slack / Google Chat / CRM webhook)
# Uncomment the line below only if you want to forward contact form inquiries to an external webhook URL:
# INQUIRY_WEBHOOK_URL=""

# Optional Google Maps JavaScript API Key for custom domain deployments (e.g., Vercel)
# VITE_GOOGLE_MAPS_API_KEY=""
